PORT=8787
HOST=0.0.0.0
NODE_ENV=development
DEMO_PULSE=false
LOG_LEVEL=warn

# Required — wallet JWT signing (min 16 chars). Copy this file to .env in hivemind-backend/.
JWT_SECRET=change-me-use-a-long-random-secret-key
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

# PostgreSQL — unset DATABASE_URL to use in-memory store. Start DB: npm run db:up
DATABASE_URL=postgresql://hivemind:hivemind@127.0.0.1:5432/hivemind

# Solana RPC (optional — wallet balances / future RPC helpers)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Groq — LLM on POST /api/agents/:id/invoke (OpenAI-compatible API).
# Key from https://console.groq.com/keys — prefix is typically gsk_...
# Must live in hivemind-backend/.env. No quotes around values. Restart API after changes.
# GROQ_API_KEY=gsk_...
# Optional — default llama-3.3-70b-versatile — https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallback (used on 429): GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Optional backoff when fallback hits 429 TPM: GROQ_429_BACKOFF_MS=12000
# Optional — default https://api.groq.com/openai/v1
# GROQ_API_BASE=https://api.groq.com/openai/v1

# OpenAI (primary LLM for swarm + repair; Groq is only the fallback).
# OPENAI_API_KEY=sk-...
# Default for all standard-priority agents.
# OPENAI_MODEL=gpt-5.5
# Stronger code model for Development/Coordination artifact-heavy + repair steps:
# OPENAI_MODEL_HEAVY=gpt-5.5-pro
# Critical-priority + final verifier pass:
# OPENAI_MODEL_CRIT=gpt-5.5-pro
# Leave UNSET. If set, forces one model everywhere and disables per-tier routing.
# A bad value (e.g. an unreleased id) makes every OpenAI call fail silently → repairs no-op.
# OPENAI_MODEL_ALL=

# Swarm: max automated verify+build repair rounds. Higher = more chances to auto-fix.
# SWARM_BUILD_REPAIR_MAX_ROUNDS=6

# Append JSON outcomes to .hivemind-logs/swarm-quality.jsonl (future preference tuning)
# SWARM_QUALITY_LOG=true
