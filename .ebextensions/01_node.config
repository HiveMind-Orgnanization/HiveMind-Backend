option_settings:
  # Default environment variables (override these in the EB Console → Configuration → Software)
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    HOST: 0.0.0.0
    LOG_LEVEL: warn
    DEMO_PULSE: "false"
    NPM_USE_PRODUCTION: "false"
    # JWT_SECRET          ← set in EB Console (min 32 chars)
    # DATABASE_URL        ← set in EB Console (RDS postgres connection string)
    # CORS_ORIGIN         ← set in EB Console (your Vercel URL, e.g. https://hivemind.vercel.app)
    # OPENAI_API_KEY      ← set in EB Console
    # GROQ_API_KEY        ← set in EB Console

# Build TypeScript before the app starts.
# NPM_USE_PRODUCTION=false ensures devDeps (typescript, tsx) are installed before this runs.
container_commands:
  01_build:
    command: "npm run build"
    leader_only: true
