{
  "name": "@hivemind/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "deploy": "npm run build && eb deploy hivemind-backend-prod"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^5.23.2",
    "pg": "^8.20.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.20.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
